# ─── Discord ───────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# The server (guild) ID where slash commands get registered
GUILD_ID=

# ─── Channel IDs ───────────────────────────────────────────
# Right-click a channel in Discord with Developer Mode on to copy its ID.
# All optional: leave blank to disable that feature.
CHANNEL_LIVE_FEED=
CHANNEL_ANNOUNCEMENTS=
CHANNEL_SUPPORT=
CHANNEL_VERIFICATION=
CHANNEL_AUDIT_LOG=

# ─── Dynamic Voice Channels ────────────────────────────────
# Generator channels: joining one creates a temporary personal channel.
# All optional.
VOICE_GEN_LOUNGE=
VOICE_GEN_MARKETPLACE=
VOICE_GEN_COMMUNITY=
VOICE_GEN_DEVELOPMENT=

# ─── NovaCont Lite (TON) ───────────────────────────────────
# Where /escrow sends users for TON agreements.
NOVACONT_LITE_URL=https://lite.novacont.tech/
NOVACONT_LITE_CONTRACT=
TON_NETWORK=mainnet

# ─── NovaCont (Base) ───────────────────────────────────────
# Where /escrow sends users for Base agreements.
NOVACONT_URL=https://www.novacont.tech
BASE_RPC_URL=

# ─── Database ──────────────────────────────────────────────
# SQLite by default. Prisma reads this directly.
DATABASE_URL="file:./nova-gateway.db"

# ─── Webhook ───────────────────────────────────────────────
# Shared secret for the /api/webhook/* endpoints. Generate a long random
# string; requests without a matching x-api-key header are rejected.
WEBHOOK_SECRET=
